<Project Sdk="Microsoft.NET.Sdk">

  <!-- MSBuild properties -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
		<RootDir Condition="'$(teamcity_version)' == '' Or '$(OS)'!='Windows_NT'">$(MSBuildProjectDirectory)</RootDir>
  </PropertyGroup>

  <!-- NuGet properties -->
  <PropertyGroup>
    <PackageId>SIL.Chorus.Mercurial</PackageId>
    <!-- TODO: Assign VersionPrefix here, let VersionSuffix be set in build -->
    <VersionPrefix>3.4.5</VersionPrefix> <!-- Will be 7.0.1 in final version of packaging setup -->
    <Authors>SIL International</Authors>
		<Copyright>Copyright (c) 2020-2022 SIL International</Copyright>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sillsdev/Mercurial4Chorus</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>native</PackageTags>
    <PackageDescription>Chorus is an end-user collaboration library via 3-way xml merging and hg dvcs under the hood.

This package provides the Mercurial implementation that Chorus uses.
</PackageDescription>
    <PackageReleaseNotes>v3.0.2: explicitly request Python 2 on Linux

v3.0.3: Allow specifying an alternate destination directory using `Mercurial4ChorusDestDir`

v6.5.1: Upgrade to Mercurial 6.5.1

v7.0.1: Upgrade to Mercurial 7.0.1
    </PackageReleaseNotes>
    <PackageReadme>docs\README.md</PackageReadme>
  </PropertyGroup>

  <!-- What to pack -->
  <ItemGroup>
    <LinuxArtifacts Include="$(RootDir)\linux-x64\**\*.*" />
    <WinArtifacts Include="$(RootDir)\win\**\*.*" />
    <Extensions Include="$(RootDir)\MercurialExtensions\**\*.*" />
    <NuSpecFile Include="$(RootDir)\assets\*.nuspec" />
    <TargetFile Include="$(RootDir)\assets\*.targets" />
  </ItemGroup>

  <!-- Of note: -->
    <!-- <RestoreOutputPath Condition="'$(RestoreOutputPath)' == ''">$(MSBuildProjectExtensionsPath)</RestoreOutputPath> -->
    <!-- <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(BaseOutputPath)$(Configuration)\</PackageOutputPath> -->
    <!-- <NuspecOutputPath Condition="'$(NuspecOutputPath)' == ''">$(BaseIntermediateOutputPath)$(Configuration)\</NuspecOutputPath> -->
  <!-- Those are defaults. I might want to override RestoreOutputPath, perhaps... -->

  <!-- Where to put things -->
  <ItemGroup>
    <Content Include="@(LinuxArtifacts)">
      <PackagePath>linux-x64\</PackagePath>
    </Content>
    <Content Include="@(WinArtifacts)">
      <PackagePath>win\</PackagePath>
    </Content>
    <Content Include="@(Extensions)">
      <PackagePath>MercurialExtensions\</PackagePath>
    </Content>
    <!-- Note the buildTransitive\ below. Hopefully this will allow packages to only consume Chorus and not have to consume SIL.Chorus.Mercurial directly. -->
    <Content Include="@(TargetFile)">
      <PackagePath>build\;buildMultiTargeting\;buildTransitive\</PackagePath>
    </Content>
  </ItemGroup>

  <!-- Not yet implemented in the above list: -->
  <!-- <Copy SourceFiles="@(NuSpecFile)" DestinationFolder="$(NuGetBuildDir)" /> -->
  <!-- <Copy SourceFiles="$(RootDir)\README.md" DestinationFolder="$(NuGetDocsFolder)" /> -->

  <!-- TODO: Test the results of packing this stuff -->
</Project>
